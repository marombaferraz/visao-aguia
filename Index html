/* =====================================================
   JOGO DIVERSIFICADO
===================================================== */

function criarJogoDiversificado(
  base,
  ranking,
  anteriores,
  indice
){

  let candidatos=
    ranking
    .map(x=>x.numero);

  let selecionados=[];

  /*
  Prioriza consenso.
  */

  let prioridade=[...base];

  /*
  Variação controlada.
  */

  prioridade.sort(
    (a,b)=>{

      const va=
        votos[b]-
        votos[a];

      if(va!==0){
        return va;
      }

      return
        Math.random()-.5;

    }
  );

  prioridade.forEach(n=>{

    if(
      selecionados.length<15
    ){

      /*
      Alguns jogos variam.
      */

      const manter=
        Math.random()>.12 ||
        indice===1;

      if(manter){

        selecionados.push(n);

      }

    }

  });

  /*
  Completar.
  */

  for(let n of candidatos){

    if(
      selecionados.length>=15
    ){
      break;
    }

    if(
      !selecionados.includes(n)
    ){

      selecionados.push(n);

    }

  }

  /*
  Garantia.
  */

  selecionados=
    [...new Set(selecionados)]
    .slice(0,15);

  while(
    selecionados.length<15
  ){

    for(let n of candidatos){

      if(
        !selecionados.includes(n)
      ){

        selecionados.push(n);

        break;

      }

    }

  }

  let jogo=
    selecionados
    .map(pad)
    .sort();

  /*
  Evitar duplicação.
  */

  let chave=jogo.join("-");

  if(
    anteriores.includes(chave)
  ){

    const a=
      Math.floor(Math.random()*15);

    const atual=
      parseInt(jogo[a]);

    const substituto=
      candidatos.find(
        n=>!selecionados.includes(n)
      );

    if(substituto){

      selecionados[
        selecionados.indexOf(atual)
      ]=substituto;

      jogo=
        selecionados
        .map(pad)
        .sort();

    }

  }

  return jogo;

}


