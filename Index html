      else if(qtd===14)
        categoria="🥇 14 ACERTOS";

      else if(qtd===13)
        categoria="🥈 13 ACERTOS";

      else if(qtd===12)
        categoria="🥉 12 ACERTOS";

      else if(qtd===11)
        categoria="✓ 11 ACERTOS";

      container.innerHTML+=`

      <div class="game">

        <b>JOGO ${index+1}</b>

        <div style="
          color:var(--gold);
          font-size:18px;
          margin-top:5px">

        ${qtd} ACERTOS

        </div>

        <div class="small">
        ${categoria}
        </div>

        <div class="grid">

        ${j.dezenas.map(d=>{

          const hit=
            ultimoResultado.dezenas
            .includes(d);

          return `

          <div class="
            ball
            ${hit?"hit":""}">

            ${d}

          </div>

          `;

        }).join("")}

        </div>

      </div>

      `;

      j.historicoConferencia=
        j.historicoConferencia||[];

      j.historicoConferencia.push({

        concurso:
          ultimoResultado.concurso,

        data:
          ultimoResultado.data,

        acertos:qtd,

        conferidoEm:
          new Date().toISOString()

      });

    }
  );

  localStorage.setItem(
    "haker_jogos",
    JSON.stringify(jogosSalvos)
  );

}


/* =====================================================
