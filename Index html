    );

    return;

  }

  const existe=
    jogosSalvos.some(
      j=>
      j.dezenas.join("-")===
      dezenas.join("-")
    );

  if(existe){

    alert(
      "Este jogo já está salvo."
    );

    return;

  }

  const pontuacao=
    dezenas.reduce(
      (total,d)=>
        total+
        votos[parseInt(d)],
      0
    );

  jogosSalvos.push({

    id:Date.now(),

    dezenas:dezenas,

    criadoEm:
      new Date().toLocaleString(
        "pt-BR"
      ),

    pontuacao:pontuacao,

    consenso:
      Math.round(
        pontuacao/15
      ),

    historicoConferencia:[]

  });

  localStorage.setItem(
    "haker_jogos",
    JSON.stringify(jogosSalvos)
  );

  alert(
    "✓ Jogo salvo com sucesso!"
  );

}


