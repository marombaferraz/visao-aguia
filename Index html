<script>

/* =====================================================
   HAKER LOTOFÁCIL
   ARMAZENAMENTO
===================================================== */

let historico =
JSON.parse(localStorage.getItem("haker_historico") || "[]");

let ultimoResultado =
JSON.parse(localStorage.getItem("haker_ultimo") || "null");

let jogosSalvos =
JSON.parse(localStorage.getItem("haker_jogos") || "[]");

let votos = Array(26).fill(0);

let robosResultados = [];

let analiseExecutada = false;


/* =====================================================
   UTILIDADES
===================================================== */

function pad(n){
  return String(n).padStart(2,"0");
}


function abrirTab(nome,botao){

  document.querySelectorAll(".tab")
  .forEach(t=>t.classList.remove("active"));

  document.querySelectorAll(".navbtn")
  .forEach(b=>b.classList.remove("active"));

  const tab=document.getElementById("tab-"+nome);

  if(tab){
    tab.classList.add("active");
  }

  if(botao){
    botao.classList.add("active");
  }

  if(nome==="jogos"){
    renderMeusJogos();
  }

  if(nome==="estatisticas"){
    renderEstatisticas();
  }

  if(nome==="historico"){
    renderHistorico();
  }

}


/* =====================================================
   VALIDAÇÃO
===================================================== */

function validarDezenas(dezenas){

  if(!Array.isArray(dezenas)){
    return false;
  }

  if(dezenas.length!==15){
    return false;
  }

  const nums=dezenas.map(x=>parseInt(x));

  if(nums.some(n=>isNaN(n))){
    return false;
  }

  if(nums.some(n=>n<1 || n>25)){
    return false;
  }

  if(new Set(nums).size!==15){
    return false;
  }

  return true;

}


/* =====================================================
   NORMALIZAR DADOS
===================================================== */

function normalizarResultado(data){

  let dezenas=
    data.dezenas ||
    data.listaDezenas ||
    data.numeros ||
    [];

  dezenas=dezenas.map(d=>pad(parseInt(d)));

  if(!validarDezenas(dezenas)){
    return null;
  }

  return {

    concurso:
      data.concurso ||
      data.numero ||
      data.numeroConcurso ||
      null,

    data:
      data.data ||
      data.dataApuracao ||
      "",

    dezenas:
      dezenas,

    fonte:
      "CAIXA",

    atualizadoEm:
      new Date().toISOString()

  };

}


/* =====================================================
   MOSTRAR RESULTADO
===================================================== */

function mostrarUltimoResultado(){

  if(!ultimoResultado){
    return;
  }

  document.getElementById("concurso").innerText=
    ultimoResultado.concurso || "----";

  document.getElementById("data").innerText=
