  const grid=
    document.getElementById("resultado");

  grid.innerHTML="";

  ultimoResultado.dezenas.forEach(d=>{

    grid.innerHTML+=`
      <div class="ball green">${d}</div>
    `;

  });

  document.getElementById("conferirInfo").innerHTML=
  `
  Concurso: <b>${ultimoResultado.concurso}</b><br>
  Data: <b>${ultimoResultado.data}</b>
  `;

}


/* =====================================================
   BUSCAR CAIXA
===================================================== */

async function buscarUltimoOficial(){

  /*
  Endpoint oficial utilizado.

  Dependendo da hospedagem, o navegador pode bloquear
  a requisição por CORS.

  Por isso o aplicativo NUNCA cria resultados falsos.
  */

  const url=
  "https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil";

  const response=await fetch(url,{
    method:"GET",
    headers:{
      "Accept":"application/json"
    }
  });

  if(!response.ok){
    throw new Error("CAIXA indisponível");
  }

  const text=await response.text();

  let json;

  try{
    json=JSON.parse(text);
  }catch(e){

    /*
    Algumas respostas podem possuir caracteres extras.
    */

    const inicio=text.indexOf("{");
    const fim=text.lastIndexOf("}");

    if(inicio>=0 && fim>=0){
      json=JSON.parse(
        text.substring(inicio,fim+1)
      );
    }else{
      throw new Error("Resposta inválida");
    }

  }

  return json;

}


/* =====================================================
   ATUALIZAR RESULTADOS
===================================================== */

async function atualizarResultados(){

  const status=
    document.getElementById("status");

  status.className="status";

  status.innerText=
  "🔄 Conectando aos resultados oficiais da CAIXA...";

  try{

    const dados=
      await buscarUltimoOficial();

    const resultado=
      normalizarResultado(dados);

    if(!resultado){
      throw new Error(
        "Resultado oficial inválido"
      );
    }

    ultimoResultado=resultado;

    localStorage.setItem(
      "haker_ultimo",
      JSON.stringify(ultimoResultado)
    );

    /*
    Adiciona ao histórico sem duplicar
    */

    const existe=
      historico.some(x=>
        String(x.concurso)===
        String(resultado.concurso)
      );

    if(!existe){

      historico.unshift(resultado);

      historico=historico
      .slice(0,100);

      localStorage.setItem(
        "haker_historico",
        JSON.stringify(historico)
      );

    }

    /*
    Tenta carregar concursos anteriores.
    */

    await carregarHistorico100();

    mostrarUltimoResultado();

    status.className="status ok";

    status.innerText=
    `✓ Dados atualizados • ${historico.length} concursos carregados`;

    atualizarInformacoes();

  }catch(error){

    console.error(error);

    status.className="status error";

    if(historico.length>0){

      status.innerText=
      "⚠️ Não foi possível atualizar os dados oficiais. Dados anteriores foram mantidos.";

    }else{

      status.innerText=
      "⚠️ Não foi possível atualizar os dados oficiais.";

    }

  }

}


/* =====================================================
   TENTAR CARREGAR 100 CONCURSOS
===================================================== */

async function carregarHistorico100(){

  /*
  IMPORTANTE:

  O aplicativo tenta carregar concursos anteriores
  utilizando a fonte da CAIXA.

  Caso a hospedagem bloqueie as chamadas, os dados
  válidos anteriores são preservados.

  Não são inventados concursos.
  */

  if(!ultimoResultado){
    return;
  }

  let numero=
    parseInt(ultimoResultado.concurso);

  if(isNaN(numero)){
    return;
  }

  /*
  Evita centenas de requisições simultâneas.
  */

  let tentativas=0;

  for(
    let concurso=numero-1;
    concurso>0 &&
    historico.length<100 &&
    tentativas<99;

    concurso--
  ){

    tentativas++;

    const existe=
    historico.some(x=>
      parseInt(x.concurso)===concurso
    );

    if(existe){
      continue;
    }

    try{

      const url=
      "https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil/"+concurso;

      const response=
        await fetch(url,{
          headers:{
            "Accept":"application/json"
          }
        });

      if(!response.ok){
        continue;
      }

      const text=
        await response.text();

      let dados;

      try{

        dados=JSON.parse(text);

      }catch(e){

        const i=text.indexOf("{");
        const f=text.lastIndexOf("}");

        if(i>=0 && f>=0){

          dados=JSON.parse(
            text.substring(i,f+1)
          );

        }else{
          continue;
        }

      }

      const resultado=
        normalizarResultado(dados);

      if(resultado){

        historico.push(resultado);

      }

      /*
      Pequena pausa.
      */

      await new Promise(
        resolve=>setTimeout(resolve,100)
      );

    }catch(e){

      /*
      Não inventar resultados.
      */

    }

  }

  historico.sort(
    (a,b)=>
      parseInt(b.concurso)-
      parseInt(a.concurso)
  );

  historico=historico.slice(0,100);

  localStorage.setItem(
    "haker_historico",
    JSON.stringify(historico)
  );

}


/* =====================================================
   ATUALIZAR INFORMAÇÕES
===================================================== */

function atualizarInformacoes(){

  document.getElementById(
    "totalConcursos"
  ).innerText=historico.length;

  const agora=new Date();

  document.getElementById(
    "horaAtualizacao"
