/* =====================================================
   ESTATÍSTICAS
===================================================== */

function renderEstatisticas(){

  const div=
    document.getElementById(
      "estatisticas"
    );

  if(historico.length===0){

    div.innerHTML=
      "Carregue resultados oficiais.";

    return;

  }

  let ranking=[];

  for(let n=1;n<=25;n++){

    ranking.push({

      numero:n,

      freq:
        frequencia(n,100),

      atraso:
        atraso(n)

    });

  }

  const quentes=
    [...ranking]
    .sort(
      (a,b)=>b.freq-a.freq
    )
    .slice(0,5);

  const frios=
    [...ranking]
    .sort(
      (a,b)=>a.freq-b.freq
    )
    .slice(0,5);

  const atrasados=
    [...ranking]
    .sort(
      (a,b)=>b.atraso-a.atraso
    )
    .slice(0,5);

  div.innerHTML=`

  <div class="card">

  <h3>🔥 Mais Frequentes</h3>

  ${quentes.map(x=>
    `${pad(x.numero)} — ${x.freq} vezes<br>`
  ).join("")}

  </div>

  <div class="card">

  <h3>❄️ Menos Frequentes</h3>

  ${frios.map(x=>
    `${pad(x.numero)} — ${x.freq} vezes<br>`
  ).join("")}

  </div>

  <div class="card">

  <h3>⏳ Maiores Atrasos</h3>

  ${atrasados.map(x=>
    `${pad(x.numero)} — ${x.atraso} concursos<br>`
  ).join("")}

  </div>

  <div class="warning">

  Estatísticas históricas descrevem
  dados anteriores. Não representam
  garantia de resultados futuros.

  </div>

  `;

}


