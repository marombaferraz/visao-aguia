/* =====================================================
   OTIMIZAR JOGO
===================================================== */

function otimizarJogo(ranking,selecionados){

  let numeros=
    selecionados
    .map(x=>parseInt(x));

  /*
  Mantém equilíbrio simples de pares.
  */

  let pares=
    numeros.filter(
      n=>n%2===0
    ).length;

  if(pares<6 || pares>9){

    /*
    Pequeno ajuste.
    */

    for(let item of ranking){

      if(
        numeros.length>=15
      ){
        break;
      }

      if(
        !numeros.includes(
          item.numero
        )
      ){

        numeros.push(
          item.numero
        );

      }

    }

  }

  return numeros
  .slice(0,15)
  .map(pad)
  .sort();

}


