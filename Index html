      <br><br>

      <b>Robôs:</b>
      ${encontrado.quantidade}

      <br>

      <b>Participantes:</b>
      ${encontrado.robos.join(", ")}

      <br>

      <b>Pontuação média:</b>
      ${media(
        encontrado.pontos
      ).toFixed(2)}

      <br><br>

      <span class="small">
      Consenso estatístico experimental.
      Não representa garantia de acerto.
      </span>

    `;

  }

  else{

    div.innerHTML=
    `
