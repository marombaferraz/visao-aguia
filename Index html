/* =====================================================
   EXPORTAR JOGOS
===================================================== */

function exportarJogos(){

  const dados=
    JSON.stringify(
      jogosSalvos,
      null,
      2
    );

  const blob=
    new Blob(
      [dados],
      {
        type:"application/json"
      }
    );

  const url=
    URL.createObjectURL(blob);

  const a=
    document.createElement("a");

  a.href=url;

  a.download=
    "haker-lotofacil-jogos.json";

  a.click();

  URL.revokeObjectURL(url);

}


/* =====================================================
   IMPORTAR JOGOS
===================================================== */

function importarJogos(event){

  const arquivo=
    event.target.files[0];

  if(!arquivo){
    return;
  }

  const reader=
    new FileReader();

  reader.onload=function(e){

    try{

      const dados=
        JSON.parse(e.target.result);

      if(!Array.isArray(dados)){
        throw new Error();
      }

      const validos=
        dados.filter(j=>
          j.dezenas &&
          validarDezenas(j.dezenas)
        );

      jogosSalvos=[
        ...jogosSalvos,
        ...validos
      ];

      localStorage.setItem(
        "haker_jogos",
        JSON.stringify(jogosSalvos)
      );

      alert(
        `✓ ${validos.length} jogos importados.`
      );

    }catch(error){

      alert(
        "Arquivo inválido."
      );

    }

  };

  reader.readAsText(arquivo);

}


/* =====================================================
   BACKTEST EXPERIMENTAL
===================================================== */

function backtestSimples(){

  /*
  Backtest temporal simples.

  Nunca utiliza concursos posteriores
  ao concurso avaliado.

  Esta função fica disponível para
  futuras expansões do projeto.
  */

  if(historico.length<20){

    return null;

  }

  let resultados=[];

  for(
    let i=10;
    i<historico.length-1;
    i++
  ){

    const passado=
      historico.slice(i);

    const alvo=
      historico[i-1];

    if(!alvo){
      continue;
    }

    let ranking=[];

    for(let n=1;n<=25;n++){

      let f=0;

      passado
      .slice(0,20)
      .forEach(c=>{

        if(
          c.dezenas.includes(
            pad(n)
          )
        ){
          f++;
        }

      });

      ranking.push({
        n:n,
        f:f
      });

    }

    ranking.sort(
      (a,b)=>b.f-a.f
    );

    const jogo=
      ranking
      .slice(0,15)
      .map(x=>pad(x.n));

    const acertos=
      jogo.filter(
        d=>
        alvo.dezenas.includes(d)
      ).length;

    resultados.push(acertos);

  }

  return {

    media:
      media(resultados),

    melhor:
      Math.max(...resultados),

    pior:
      Math.min(...resultados),

    resultados:
      resultados

  };

}


