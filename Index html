      "pt-BR",
      {
        hour:"2-digit",
        minute:"2-digit"
      }
    );

}


/* =====================================================
   MÉTRICAS
===================================================== */

function frequencia(numero,janela){

  let total=0;

  historico
  .slice(0,janela)
  .forEach(concurso=>{

    if(
      concurso.dezenas.includes(
        pad(numero)
      )
    ){
      total++;
    }

  });

  return total;

}


function atraso(numero){

  const dezena=pad(numero);

  for(let i=0;i<historico.length;i++){

    if(
      historico[i]
      .dezenas
      .includes(dezena)
    ){
      return i;
    }

  }

  return historico.length;

}


function media(arr){

  if(!arr.length){
    return 0;
  }

  return arr.reduce(
    (a,b)=>a+b,0
  )/arr.length;

}


function desvioPadrao(arr){

  const m=media(arr);

  const v=
  media(
    arr.map(x=>
      Math.pow(x-m,2)
    )
  );

  return Math.sqrt(v);

}


function ehPrimo(n){

  if(n<2){
    return false;
  }

  for(let i=2;i*i<=n;i++){

    if(n%i===0){
      return false;
    }

  }

  return true;

}


function fibonacci(){

  return [1,2,3,5,8,13,21];

}


function moldura(n){

  return [
    1,2,3,4,5,
    6,10,
    11,15,
    16,20,
    21,22,23,24,25
  ].includes(n);

}


/* =====================================================
   PONTUAÇÃO DE UMA DEZENA
===================================================== */

function pontuarNumero(numero,config){

  const f100=
    frequencia(numero,100);

  const f50=
    frequencia(numero,50);

  const f30=
    frequencia(numero,30);

  const f20=
    frequencia(numero,20);

  const f10=
    frequencia(numero,10);

  const f5=
    frequencia(numero,5);

  const atr=
    atraso(numero);

  let score=0;

  score+=f100*
    (config.w100||1);

  score+=f50*
    (config.w50||0);

  score+=f30*
    (config.w30||0);

  score+=f20*
    (config.w20||0);

  score+=f10*
    (config.w10||0);

  score+=f5*
    (config.w5||0);

  score+=atr*
    (config.wAtraso||0);

  if(ehPrimo(numero)){
    score+=config.wPrimo||0;
  }

  if(fibonacci().includes(numero)){
    score+=config.wFib||0;
  }

  if(moldura(numero)){
    score+=config.wMoldura||0;
  }

  if(numero%3===0){
    score+=config.wMult3||0;
  }

  if(numero%5===0){
    score+=config.wMult5||0;
  }

  return score;

}


/* =====================================================
   CRIAR CONFIGURAÇÃO DO ROBÔ
===================================================== */

function configuracaoRobo(id){

  const grupo=
    Math.ceil(id/10);

  let c={
    w100:1,
    w50:0,
    w30:0,
    w20:0,
    w10:0,
    w5:0,
    wAtraso:0,
    wPrimo:0,
    wFib:0,
    wMoldura:0,
    wMult3:0,
    wMult5:0,
    grupo:grupo
  };

  /*
  Robôs 1–10
  FREQUÊNCIA
  */

  if(id>=1 && id<=10){

    c.w100=
      1+(id%3)*0.25;

    c.w50=
      0.3+(id%4)*0.1;

  }

  /*
  Robôs 11–20
  RECÊNCIA
  */

  else if(id<=20){

    c.w10=
      1+(id%5)*0.2;

    c.w5=
      .5+(id%3)*.2;

    c.w100=.2;

  }

  /*
  Robôs 21–30
  ATRASOS
  */

  else if(id<=30){

    c.w100=.4;

    c.wAtraso=
      .2+(id%5)*.1;

  }

  /*
  Robôs 31–40
  COOCORRÊNCIA
  */

  else if(id<=40){

    c.w50=.6;

    c.w30=.6;

    c.w10=.3;

  }

  /*
  Robôs 41–50
  PARIDADE / DISTRIBUIÇÃO
  */

  else if(id<=50){

    c.w100=.7;

    c.wPrimo=
      (id%3)*.15;

    c.wMoldura=
      (id%4)*.1;

  }

  /*
  Robôs 51–60
  SOMA / ESPAÇAMENTO
  */

  else if(id<=60){

    c.w50=.8;

    c.w20=.4;

    c.wFib=
      (id%3)*.1;

  }

  /*
  Robôs 61–70
  SEQUÊNCIAS
  */

  else if(id<=70){

    c.w30=.7;

    c.w10=.7;

    c.wMult3=
      (id%3)*.1;

  }

  /*
  Robôs 71–80
  MONTE CARLO
  */

  else if(id<=80){

    c.w100=.8;

    c.w50=.4;

    c.monteCarlo=true;

  }

  /*
  Robôs 81–90
  OTIMIZAÇÃO
  */

  else if(id<=90){

    c.w100=.7;

    c.w30=.5;

    c.wAtraso=.2;

    c.otimizacao=true;

  }

  /*
  Robôs 91–99
  BACKTEST / ESTABILIDADE
  */

  else if(id<=99){

    c.w100=.6;

    c.w50=.6;

    c.w20=.3;

    c.estabilidade=true;

  }

  /*
  ROBÔ 100
  MASTER ENSEMBLE
  */

  else{

    c.w100=.8;
    c.w50=.6;
    c.w30=.5;
    c.w20=.4;
    c.w10=.4;
    c.w5=.3;
    c.wAtraso=.2;

    c.master=true;

  }

  return c;

}


/* =====================================================
   MONTE CARLO
===================================================== */

function simulacaoMonteCarlo(){

  let resultado=
    Array(26).fill(0);

  if(historico.length===0){
    return resultado;
  }

  /*
  Simulação estatística experimental.
  */

  for(let s=0;s<300;s++){

    const sorteio=
      historico[
        Math.floor(
          Math.random()*historico.length
        )
      ];

    sorteio.dezenas.forEach(d=>{

      resultado[
        parseInt(d)
      ]++;

    });

  }

  return resultado;

}


/* =====================================================
   EXECUTAR UM ROBÔ
===================================================== */

function executarRobo(id){

  const config=
    configuracaoRobo(id);

  let ranking=[];

  let monteCarlo=[];

  if(config.monteCarlo){
    monteCarlo=
      simulacaoMonteCarlo();
  }

  for(let n=1;n<=25;n++){

    let score=
      pontuarNumero(
        n,
        config
      );

    if(config.monteCarlo){

      score+=
        monteCarlo[n]*.05;

    }

    ranking.push({
      numero:n,
      score:score
    });

  }

  ranking.sort(
    (a,b)=>b.score-a.score
  );

  let selecionados=
    ranking
    .slice(0,15)
    .map(x=>pad(x.numero))
    .sort();

  /*
  OTIMIZAÇÃO:
  equilíbrio básico.
  */

  if(config.otimizacao){

    selecionados=
      otimizarJogo(
        ranking,
        selecionados
      );

  }

  return {

    id:id,

    grupo:config.grupo,

    ranking:ranking,

    selecionados:selecionados,

    pontuacao:
      media(
        ranking
        .slice(0,15)
        .map(x=>x.score)
      ),

    justificativa:
      justificativaRobo(id,config)

  };

}


