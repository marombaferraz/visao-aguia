function calcularConsensoExato(){

  const mapa={};

  robosResultados.forEach(r=>{

    const chave=
      r.selecionados.join("-");

    if(!mapa[chave]){

      mapa[chave]={
        quantidade:0,
        robos:[],
        pontos:[]
      };

    }

    mapa[chave]
    .quantidade++;

    mapa[chave]
    .robos
    .push(r.id);

    mapa[chave]
    .pontos
    .push(r.pontuacao);

  });

  let encontrado=null;

  Object.keys(mapa).forEach(chave=>{

    if(
      mapa[chave].quantidade>=5
    ){

      if(
        !encontrado ||
        mapa[chave].quantidade>
        encontrado.quantidade
      ){

        encontrado={
          chave:chave,
          ...mapa[chave]
        };

      }

    }

  });

  const div=
    document.getElementById(
      "consensoExato"
    );

  if(encontrado){

    div.innerHTML=`

      <div style="color:var(--gold);font-weight:bold">
      🔥 CONSENSO EXATO
