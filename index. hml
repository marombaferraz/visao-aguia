/* =========================================================
   BACKTEST TEMPORAL
   ========================================================= */

async function runBacktest(){

  const box=document.getElementById("backtestResult");

  if(history.length<15){

    box.innerText=
      "É necessário ter pelo menos 15 concursos.";

    return;
  }

  box.innerText=
    "Executando backtest sem utilizar o futuro...";

  await sleep(50);

  /*
    Testa até 20 concursos.

    Para cada concurso-alvo:
    - usa apenas os concursos posteriores na lista
      (mais antigos cronologicamente)
    - cria ranking
    - seleciona 15 dezenas
    - compara com o concurso-alvo
  */

  const ordered=[...history]
    .sort((a,b)=>a.concurso-b.concurso);

  const start=Math.max(10,ordered.length-20);

  const hits=[];

  for(let i=start;i<ordered.length;i++){

    const target=ordered[i];

    const training=ordered.slice(0,i);

    if(training.length<10)
      continue;

    const f=frequencyMap(training);

    const selected=numbers15()
      .sort((a,b)=>f[b]-f[a])
      .slice(0,15);

    const h=intersection(
      selected,
      target.dezenas
    ).length;

    hits.push(h);

    await sleep(5);
  }

  if(!hits.length){

    box.innerText=
      "Não foi possível executar o backtest.";

    return;
  }

  box.innerHTML=`

    <div class="stats">

      <div class="stat">
        Testes
        <b>${hits.length}</b>
      </div>

      <div class="stat">
        Média de acertos
        <b>${average(hits).toFixed(2)}</b>
      </div>

      <div class="stat">
        Melhor resultado
        <b>${Math.max(...hits)}</b>
      </div>

      <div class="stat">
        Mediana
        <b>${median(hits)}</b>
      </div>

    </div>

    <p style="margin-top:10px">
      Resultados:
      ${hits.join(" • ")}
    </p>

  `;
}


