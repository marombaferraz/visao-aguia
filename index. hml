<script>

/* =========================================================
   HAKER LOTOFÁCIL
   MOTOR PRINCIPAL
   ========================================================= */

const STORAGE = {
  history:"haker_lf_history_v3",
  games:"haker_lf_games_v3",
  analysis:"haker_lf_analysis_v3",
  settings:"haker_lf_settings_v3"
};

let history = loadJSON(STORAGE.history,[]);
let savedGames = loadJSON(STORAGE.games,[]);
let analysis = loadJSON(STORAGE.analysis,null);

let settings = loadJSON(
  STORAGE.settings,
  {threshold:5}
);

let latest = null;


/* =========================================================
   UTILIDADES
   ========================================================= */

function loadJSON(key,fallback){
  try{
    const x=localStorage.getItem(key);
    return x ? JSON.parse(x) : fallback;
  }catch(e){
    return fallback;
  }
}

function saveJSON(key,value){
  localStorage.setItem(key,JSON.stringify(value));
}

function sleep(ms){
  return new Promise(r=>setTimeout(r,ms));
}

function numbers15(){
  const a=[];
  for(let i=1;i<=25;i++) a.push(i);
  return a;
}

function sorted15(a){
  return [...new Set(a.map(Number))]
    .filter(n=>n>=1 && n<=25)
    .sort((a,b)=>a-b)
    .slice(0,15);
}

function sum(a){
  return a.reduce((x,y)=>x+y,0);
}

function average(a){
  return a.length ? sum(a)/a.length : 0;
}

function median(a){
  if(!a.length)return 0;
  const b=[...a].sort((x,y)=>x-y);
  const m=Math.floor(b.length/2);
  return b.length%2 ? b[m] : (b[m-1]+b[m])/2;
}

function std(a){
  if(a.length<2)return 0;
  const av=average(a);
  return Math.sqrt(
    a.reduce((s,x)=>s+Math.pow(x-av,2),0)/a.length
  );
}

function clamp(x,min,max){
  return Math.max(min,Math.min(max,x));
}

function random(){
  return Math.random();
}

function shuffle(a){
  const b=[...a];

  for(let i=b.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [b[i],b[j]]=[b[j],b[i]];
  }

  return b;
}

function intersection(a,b){
  const set=new Set(b);
  return a.filter(x=>set.has(x));
}

function formatDate(d){
  if(!d)return "--/--/----";

  if(/^\d{2}\/\d{2}\/\d{4}$/.test(d))
    return d;

  const x=new Date(d);

  if(isNaN(x.getTime()))
    return String(d);

  return x.toLocaleDateString("pt-BR");
}


/* =========================================================
   NAVEGAÇÃO
   ========================================================= */

function openTab(id,button){

  document.querySelectorAll(".tab")
    .forEach(x=>x.classList.remove("active"));

  document.getElementById("tab-"+id)
    .classList.add("active");

  document.querySelectorAll(".nav button")
    .forEach(x=>x.classList.remove("active"));

  if(button)
    button.classList.add("active");

  if(id==="jogos")
    renderSavedGames();

  if(id==="historico")
    renderHistory();

  if(id==="estatisticas")
    renderStatistics();
}


/* =========================================================
   CONFIGURAÇÃO
   ========================================================= */

document.getElementById("threshold").value=settings.threshold;

function saveSettings(){

  let n=parseInt(
    document.getElementById("threshold").value
  );

  if(!n || n<1)n=5;
  if(n>100)n=100;

  settings.threshold=n;

  document.getElementById("threshold").value=n;
  document.getElementById("thresholdView").innerText=n;

  saveJSON(STORAGE.settings,settings);

  if(analysis)
    renderAnalysis();
}


/* =========================================================
   LEITURA OFICIAL
   ========================================================= */

/*
  O aplicativo tenta primeiro uma função de servidor
  no próprio domínio:

       /api/lotofacil

  Isso é o recomendado para evitar CORS.

  Depois tenta diretamente o serviço oficial da CAIXA.

  Não existe geração de resultado falso.
*/

const OFFICIAL_ENDPOINT =
  "https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil";

async function fetchContest(number=null){

  const urls=[];

  if(number){
    urls.push("/api/lotofacil/"+number);
    urls.push(
      "https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil/"+number
    );
  }else{
    urls.push("/api/lotofacil");
    urls.push(OFFICIAL_ENDPOINT);
  }

  for(const url of urls){

    try{

      const response=await fetch(url,{
        method:"GET",
        cache:"no-store",
        headers:{
          "Accept":"application/json"
        }
      });

      if(!response.ok)
        continue;

      const data=await response.json();

      const normalized=normalizeContest(data);

      if(normalized)
        return normalized;

    }catch(e){
      /* tenta próxima fonte */
    }
  }

  return null;
}


function normalizeContest(data){

  if(!data || typeof data!=="object")
    return null;

  let number =
    data.numero ??
    data.concurso ??
    data.number ??
    data.numeroConcurso;

  let date =
    data.dataApuracao ??
    data.data ??
    data.date ??
    data.dataSorteio;

  let raw =
    data.listaDezenas ??
    data.dezenas ??
    data.dezenasSorteadas ??
    data.numbers;

  if(Array.isArray(raw)){

    raw=raw
      .map(x=>{
        if(typeof x==="object")
          return x.numero ?? x.valor ?? x.dezena;

        return x;
      })
      .map(Number)
      .filter(n=>n>=1 && n<=25);

  }else{
    raw=[];
  }

  raw=[...new Set(raw)].sort((a,b)=>a-b);

  if(raw.length!==15)
    return null;

  if(number===undefined || number===null)
    return null;

  return {
    concurso:Number(number),
    data:formatDate(date),
    dezenas:raw
  };
}


/* =========================================================
   CARREGAR 100 CONCURSOS
   ========================================================= */

async function loadOfficialData(){

  const status=document.getElementById("status");

  status.innerText=
    "🔄 Consultando resultados oficiais da CAIXA...";

  status.classList.add("loading");

  try{

    let first=await fetchContest();

    if(!first)
      throw new Error("Fonte oficial indisponível");

    latest=first;

    document.getElementById("lastContest").innerText=
      first.concurso;

    document.getElementById("lastDate").innerText=
      first.data;

    renderLatest(first);

    /*
      Começa pelo último concurso encontrado e busca
      os 99 anteriores.
    */

    const results=[first];

    const start=first.concurso;

    for(let i=1;i<100;i++){

      const number=start-i;

      if(number<1)break;

      status.innerText=
        `🔄 Baixando concurso ${i+1}/100...`;

      const item=await fetchContest(number);

      if(item)
        results.push(item);

      await sleep(35);
    }

    /*
      Remove duplicados e mantém apenas os 100 mais recentes.
    */

    const map=new Map();

    for(const r of results)
      map.set(r.concurso,r);

    history=[...map.values()]
      .sort((a,b)=>b.concurso-a.concurso)
      .slice(0,100);

    saveJSON(STORAGE.history,history);

    document.getElementById("historyCount").innerText=
      history.length;

    status.classList.remove("loading");

    if(history.length>=1){

      status.innerText=
        `✓ ${history.length} concursos oficiais carregados.`;

      calculateStatistics();

    }else{

      status.innerText=
        "⚠️ Não foi possível carregar o histórico.";

    }

    renderHistory();

    renderStatistics();

    if(analysis)
      renderAnalysis();

  }catch(e){

    status.classList.remove("loading");

    status.innerText=
      "⚠️ Fonte oficial indisponível. Nenhum resultado foi inventado.";

    /*
      Se já existir histórico salvo, ele continua funcionando.
    */

    if(history.length){

      const first=history[0];

      latest=first;

      renderLatest(first);

      document.getElementById("historyCount").innerText=
        history.length;

      status.innerText=
        `⚠️ Sem atualização. Usando ${history.length} concursos salvos.`;

    }
  }
}


function renderLatest(data){

  document.getElementById("lastContest").innerText=
    data.concurso;

  document.getElementById("lastDate").innerText=
    data.data;

  const grid=document.getElementById("latestNumbers");

  grid.innerHTML="";

  data.dezenas.forEach(n=>{

    const d=document.createElement("div");

    d.className="ball green";

    d.innerText=String(n).padStart(2,"0");

    grid.appendChild(d);

  });
}


/* =========================================================
   MÉTRICAS HISTÓRICAS
   ========================================================= */

function frequencyMap(data){

  const f=Array(26).fill(0);

  data.forEach(c=>{
    c.dezenas.forEach(n=>f[n]++);
  });

  return f;
}


function lastSeenMap(data){

  const result={};

  for(let n=1;n<=25;n++)
    result[n]=999;

  data.forEach((c,index)=>{

    c.dezenas.forEach(n=>{

      if(result[n]===999)
        result[n]=index;

    });

  });

  return result;
}


function delayMap(data){

  const result={};

  for(let n=1;n<=25;n++){

    let delay=0;

    for(const c of data){

      if(c.dezenas.includes(n))
        break;

      delay++;
    }

    result[n]=delay;
  }

  return result;
}


function pairFrequency(data){

  const map={};

  data.forEach(c=>{

    const d=c.dezenas;

    for(let i=0;i<d.length;i++){

      for(let j=i+1;j<d.length;j++){

        const key=d[i]+"-"+d[j];

        map[key]=(map[key]||0)+1;
      }
    }

  });

  return map;
}


function tripleFrequency(data){

  const map={};

  /*
    Para manter o aplicativo leve no celular,
    calculamos apenas trios dentro das combinações
    dos concursos.
  */

  data.forEach(c=>{

    const d=c.dezenas;

    for(let i=0;i<d.length;i++){

      for(let j=i+1;j<d.length;j++){

        for(let k=j+1;k<d.length;k++){

          const key=
            d[i]+"-"+d[j]+"-"+d[k];

          map[key]=(map[key]||0)+1;
        }
      }
    }

  });

  return map;
}


function numberFeatures(data){

  const freq=frequencyMap(data);
  const delay=delayMap(data);
  const seen=lastSeenMap(data);

  const recent=data.slice(0,10);
  const medium=data.slice(0,30);
  const long=data.slice(0,100);

  const f10=frequencyMap(recent);
  const f30=frequencyMap(medium);
  const f100=frequencyMap(long);

  const features={};

  for(let n=1;n<=25;n++){

    features[n]={
      n,
      f10:f10[n],
      f30:f30[n],
      f100:f100[n],
      delay:delay[n],
      recency:seen[n]
    };

  }

  return features;
}


/* =========================================================
   100 ROBÔS
   ========================================================= */

function robotScore(robot,data){

  const f=numberFeatures(data);

  const freq100=frequencyMap(data);

  const pair=pairFrequency(data);

  const recent=data.slice(0,10);

  const recentFreq=frequencyMap(recent);

  const scores={};

  for(let n=1;n<=25;n++){

    const x=f[n];

    let score=0;

    /*
      1-10 ANÁLISE DE LINGUAGEM NATURAL E EMBEDDINGS (PNL NUMÉRICO)
    */

    if(robot<=10){

      const variant=robot-1;

      // Matriz de Transição e Contexto Numérico (PNL Bigram)
      let bigramWeight=0;
      data.forEach(c=>{
        const d=c.dezenas;
        if(d.includes(n)){
          d.forEach(neighbor=>{
            if(Math.abs(neighbor-n)<=2 && neighbor!==n) bigramWeight+=0.12;
          });
        }
      });

      // Função de Dispersão e Entropia da Dezena
      const tfIDF_Numeric = (x.f10 / 10.0) * Math.log(100.0 / (x.f100 + 1));
      const vectorSimilarity = Math.cos((n * Math.PI) / 25.0) * (variant * 0.05);

      score =
        x.f100 * (0.8 + variant * 0.01) +
        bigramWeight * (0.5 + variant * 0.02) +
        tfIDF_Numeric * (1.5 + variant * 0.05) +
        vectorSimilarity;

    }

    /*
      11-20 RECÊNCIA
    */

    else if(robot<=20){

      const variant=robot-11;

      score =
        x.f10*(2+variant*.08) +
        x.f30*(.7+variant*.03) -
        x.recency*(.15+variant*.01);

    }

    /*
      21-30 ATRASOS
    */

    else if(robot<=30){

      const variant=robot-21;

      score =
        x.delay*(1+variant*.04) +
        (x.delay>=3 ? 4 : 0) +
        x.f100*.08;

    }

    /*
      31-40 COOCORRÊNCIA
    */

    else if(robot<=40){

      const variant=robot-31;

      let pairScore=0;

      for(let k=1;k<=25;k++){

        if(k===n)continue;

        const a=Math.min(n,k);
        const b=Math.max(n,k);

        pairScore+=pair[a+"-"+b]||0;
      }

      score =
        pairScore*(.015+variant*.002) +
        x.f30*.25;

    }

    /*
      41-50 PARIDADE E DISTRIBUIÇÃO
    */

    else if(robot<=50){

      const variant=robot-41;

      const odd=(n%2===1)?1:0;

      const idealParity =
        variant%2===0 ? odd : 1-odd;

      score =
        (idealParity?1.5:1) +
        x.f30*.18 +
        (n<=8?1.2:0) +
        (n>=18?1.1:0);

    }

    /*
      51-60 SOMA E ESPAÇAMENTO
    */

    else if(robot<=60){

      const variant=robot-51;

      const center=13;

      score =
        8-Math.abs(n-center)*.25 +
        x.f100*.18 +
        (variant%3)*.15;

    }

    /*
      61-70 SEQUÊNCIAS E REPETIÇÃO
    */

    else if(robot<=70){

      const variant=robot-61;

      let repetition=0;

      for(let i=0;i<Math.min(5,data.length);i++){

        if(data[i].dezenas.includes(n))
          repetition++;

      }

      score =
        repetition*(1+variant*.04) +
        x.f30*.25;

    }

    /*
      71-80 MONTE CARLO SIMPLIFICADO
    */

    else if(robot<=80){

      const variant=robot-71;

      let monte=0;

      for(let k=0;k<80;k++){

        monte +=
          Math.random() <
          clamp(x.f100/(data.length*15),.01,.8)
          ? 1 : 0;

      }

      score =
        monte*(1+variant*.015) +
        x.f30*.15;

    }

    /*
      81-90 OTIMIZAÇÃO
    */

    else if(robot<=90){

      const variant=robot-81;

      score =
        x.f10*1.3 +
        x.f30*.6 +
        x.f100*.25 +
        (25-x.delay)*.08 +
        (n<=13?variant*.02:0);

    }

    /*
      91-99 BACKTEST / ESTABILIDADE
    */

    else if(robot<=99){

      const variant=robot-91;

      const windows=[
        data.slice(0,10),
        data.slice(0,20),
        data.slice(0,30),
        data.slice(0,50)
      ];

      let stability=0;

      windows.forEach(w=>{
        const fm=frequencyMap(w);
        stability += fm[n]||0;
      });

      score =
        stability*(.15+variant*.008) +
        x.f100*.15;

    }

    /*
      100 MASTER ENSEMBLE
    */

    else{

      score =
        x.f10*1.5 +
        x.f30*.8 +
        x.f100*.5 +
        x.delay*.2 +
        recentFreq[n]*.4;

    }

    scores[n]=score;

  }

  return scores;
}


function selectRobotNumbers(scores){

  return Object.entries(scores)
    .sort((a,b)=>b[1]-a[1])
    .slice(0,15)
    .map(x=>Number(x[0]))
    .sort((a,b)=>a-b);
}


async function runRobots(){

  if(history.length<5){

    alert(
      "Carregue primeiro os resultados oficiais da CAIXA."
    );

    return;
  }

  const progress=document.getElementById("progressBar");
  const status=document.getElementById("robotStatus");

  const votes=Array(26).fill(0);
  const robots=[];
  const combinations={};

  for(let robot=1;robot<=100;robot++){

    status.innerText=
      `Executando Robô ${robot}/100...`;

    progress.style.width=
      robot+"%";

    const scores=robotScore(robot,history);

    const selected=selectRobotNumbers(scores);

    selected.forEach(n=>{
      votes[n]++;
    });

    const key=selected.join(",");

    combinations[key]=
      (combinations[key]||0)+1;

    robots.push({
      id:robot,
      selected,
      score:average(selected.map(n=>scores[n]))
    });

    /*
      Dá tempo para o celular atualizar a interface.
    */

    if(robot%4===0)
      await sleep(10);
  }

  analysis={
    timestamp:new Date().toISOString(),
    threshold:settings.threshold,
    votes,
    robots,
    combinations
  };

  saveJSON(STORAGE.analysis,analysis);

  progress.style.width="100%";

  status.innerText=
    "✓ 100 robôs concluíram a análise.";

  renderAnalysis();

  document.getElementById("consensusCount").innerText=
    countConsensus()+" dezenas";
}


function countConsensus(){

  if(!analysis)return 0;

  const t=settings.threshold;

  return analysis.votes
    .slice(1)
    .filter(v=>v>=t)
    .length;
}


