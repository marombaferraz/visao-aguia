/* =========================================================
   GERAÇÃO DE JOGOS
   ========================================================= */

function weightedNumberPool(){

  if(!analysis){

    return numbers15();
  }

  const pool=[];

  for(let n=1;n<=25;n++){

    const votes=analysis.votes[n];

    /*
      O consenso aumenta a chance de seleção,
      mas não obriga todos os jogos a serem iguais.
    */

    const weight=
      1+
      votes*2.2;

    for(let i=0;i<Math.ceil(weight);i++)
      pool.push(n);

  }

  return pool;
}


function createGame(){

  const pool=weightedNumberPool();

  let best=null;

  for(let attempt=0;attempt<80;attempt++){

    const selected=[];

    const shuffled=shuffle(pool);

    for(const n of shuffled){

      if(!selected.includes(n))
        selected.push(n);

      if(selected.length===15)
        break;

    }

    if(selected.length!==15)
      continue;

    selected.sort((a,b)=>a-b);

    const s=sum(selected);

    /*
      Preferência por faixa de soma equilibrada.
    */

    const sumPenalty=
      Math.abs(s-195);

    if(!best ||
       sumPenalty <
       Math.abs(sum(best)-195)){

      best=selected;
    }

  }

  if(!best){

    best=shuffle(numbers15()).slice(0,15)
      .sort((a,b)=>a-b);
  }

  return best;
}


function similarity(a,b){

  return intersection(a,b).length;
}


function generateGames(){

  const qtd=parseInt(
    document.getElementById("gameQuantity").value
  );

  const box=document.getElementById("generatedGames");

  const games=[];

  let attempts=0;

  while(games.length<qtd && attempts<qtd*200){

    attempts++;

    const game=createGame();

    /*
      Diversificação:
      dois jogos normalmente não devem compartilhar
      todas as mesmas dezenas.
    */

    let valid=true;

    for(const old of games){

      if(similarity(game,old)>13){

        valid=false;
        break;
      }

    }

    if(valid)
      games.push(game);

  }

  box.innerHTML="";

  games.forEach((game,index)=>{

    box.innerHTML+=`

      <div class="game">

        <div class="game-title">
          <b>JOGO ${index+1}</b>
          <span class="badge">15 dezenas</span>
