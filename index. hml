}

.ball.green{background:#16864f;border-color:#20c77a}
.ball.gold{background:#b99b00;color:#fff;border-color:#ffd700}
.ball.red{background:#8d2929;border-color:#ef5350}
.ball.blue{background:#145f88;border-color:#29a9ff}

.nav{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:100;
  height:70px;
  background:#18181b;
  border-top:1px solid #333;
  display:flex;
  justify-content:space-around;
  padding-bottom:env(safe-area-inset-bottom);
}

.nav button{
  flex:1;
  background:none;
  border:0;
  color:#888;
  font-size:.65rem;
  font-weight:700;
}

.nav button.active{
  color:var(--gold);
}

.tab{display:none}
.tab.active{display:block}

.stats{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px;
}

.stat{
  background:var(--card2);
  padding:12px;
  border-radius:10px;
  text-align:center;
}

.stat b{
  display:block;
  color:var(--gold);
  font-size:1.15rem;
  margin-top:4px;
}

.progress{
  width:100%;
  height:10px;
  background:#333;
  border-radius:20px;
  overflow:hidden;
  margin:10px 0;
}

.progress div{
  height:100%;
  width:0%;
  background:var(--gold);
  transition:.15s;
}

.row{
  display:flex;
  gap:8px;
}

.row>*{
  flex:1;
}

select,input{
  width:100%;
  background:#29292e;
  color:#fff;
  border:1px solid #444;
  border-radius:8px;
  padding:11px;
}

.game{
  background:#202024;
  border:1px solid #35353a;
  border-radius:12px;
  padding:12px;
  margin-bottom:10px;
}

.game-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:6px;
}

.badge{
  display:inline-block;
  padding:4px 7px;
  border-radius:20px;
  font-size:.65rem;
  font-weight:bold;
  background:#333;
}

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:.72rem;
}

th,td{
  padding:8px 5px;
  border-bottom:1px solid #333;
  text-align:center;
}

th{
  color:var(--gold);
}

.loading{
  animation:pulse 1s infinite alternate;
}

@keyframes pulse{
  from{opacity:.5}
  to{opacity:1}
}

.notice{
  background:#211f12;
  border:1px solid #5b5100;
  color:#e9db71;
  border-radius:9px;
  padding:10px;
  font-size:.72rem;
  line-height:1.4;
  margin-top:10px;
}

.footer{
  text-align:center;
  color:#666;
  font-size:.65rem;
  line-height:1.4;
  padding:10px;
}

.hidden{display:none!important}
</style>
</head>

