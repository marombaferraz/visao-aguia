<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#101010">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>HAKER LOTOFÁCIL</title>

<style>
:root{
  --bg:#0d0d0f;
  --card:#18181b;
  --card2:#202024;
  --line:#303036;
  --gold:#ffd700;
  --green:#20c77a;
  --red:#ef5350;
  --blue:#29a9ff;
  --orange:#ff9800;
  --text:#f5f5f5;
  --muted:#999;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,Helvetica,sans-serif;
}

html{scroll-behavior:smooth}

body{
  background:var(--bg);
  color:var(--text);
  padding-bottom:82px;
  min-height:100vh;
}

button,select,input{
  font:inherit;
}

button{
  cursor:pointer;
}

header{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(18,18,18,.97);
  border-bottom:1px solid #333;
  padding:14px 12px;
  text-align:center;
}

.logo{
  color:var(--gold);
  font-size:1.35rem;
  font-weight:900;
}

.subtitle{
  color:var(--muted);
  font-size:.72rem;
  margin-top:4px;
}

.container{
  width:100%;
  max-width:720px;
  margin:auto;
  padding:12px;
}

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:15px;
  margin-bottom:12px;
  box-shadow:0 5px 20px rgba(0,0,0,.18);
}

.card h2,.card h3,.card h4{
  margin-bottom:9px;
}

.small{
  color:var(--muted);
  font-size:.78rem;
  line-height:1.45;
}

.status{
  display:block;
  padding:9px 10px;
  background:#111;
  border-radius:8px;
  color:var(--blue);
  font-size:.78rem;
  margin-bottom:12px;
}

.btn{
  width:100%;
  border:0;
  border-radius:9px;
  padding:12px;
  margin-top:8px;
  font-weight:800;
  font-size:.88rem;
}

.btn-gold{background:var(--gold);color:#000}
.btn-green{background:var(--green);color:#001b0f}
.btn-blue{background:var(--blue);color:#00131f}
.btn-red{background:var(--red);color:#fff}
.btn-dark{background:#303036;color:#fff}

.grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:8px;
  margin:12px 0;
}

.ball{
  aspect-ratio:1;
  max-width:48px;
  width:100%;
  margin:auto;
  border-radius:50%;
  background:#303036;
  display:flex;
  justify-content:center;
