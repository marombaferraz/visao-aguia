    document.getElementById("status").innerText=
      `✓ ${history.length} concursos salvos disponíveis.`;

  }

  if(analysis)
    renderAnalysis();

  /*
    Atualiza automaticamente na abertura.
    Se não houver internet, mantém os dados locais.
  */

  loadOfficialData();
}

initialize();

</script>

</body>
</html>
