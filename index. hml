        </div>

        <button
          class="btn btn-green"
          onclick='saveGame(${JSON.stringify(game)})'>
          💾 SALVAR JOGO
        </button>

        <button
          class="btn btn-dark"
          onclick='copyGame(${JSON.stringify(game)})'>
          📋 COPIAR JOGO
        </button>

      </div>

    `;
  });
}


